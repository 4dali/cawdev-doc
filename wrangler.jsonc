// Cloudflare Workers, static assets only.
//
// The site is a static Astro build, so there is no Worker script and no
// @astrojs/cloudflare adapter: `wrangler deploy` uploads `dist/` and serves
// it. Without this file Wrangler tries to auto-configure the project, runs
// `astro add cloudflare`, and installs an adapter the build does not need
// (and that does not support Astro 7).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cawdev-doc",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist",
		// Starlight emits 404.html; serve it for unknown paths.
		"not_found_handling": "404-page"
	}
}
